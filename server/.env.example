# Server port (default: 5000)
PORT=5000

# MongoDB connection string (required, must start with "mongodb")
# Example for Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/harbor
MONGODB_URI=mongodb://127.0.0.1:27017/harbor

# development | production | test (default: development)
NODE_ENV=development

# fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info