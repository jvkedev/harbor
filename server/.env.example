# Server port (default: 5000)
PORT=5000

# MongoDB connection string (required, must start with "mongodb")
# Example for Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/harbor
MONGODB_URI=mongodb://127.0.0.1:27017/harbor

# development | production | test (default: development)
NODE_ENV=development

# fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# Secret used to sign access tokens (min 32 chars). Generate: jwtsecrets.com
JWT_ACCESS_SECRET=replace_me_with_a_long_random_secret_at_least_32_chars

# Access token lifetime in seconds (900 = 15 minutes)
JWT_ACCESS_EXPIRES_SECONDS=900